# SocialFlow Frontend Environment Variables

# Backend API Base URL
# - If frontend and backend are hosted on the SAME domain/host (e.g. Hostinger public_html):
#   Leave this EMPTY or set to:
#   VITE_API_BASE_URL=
#
# - If backend is hosted on a separate domain or subdomain (e.g. api.yourdomain.com):
#   Set to the backend base URL (without trailing slash):
#   VITE_API_BASE_URL=https://api.yourdomain.com
#
# - For local development:
#   Leave empty to use Vite dev proxy (recommended) or set to http://localhost:8000:
VITE_API_BASE_URL=
